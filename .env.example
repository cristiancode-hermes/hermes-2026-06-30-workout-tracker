# Workout Tracker API Configuration
# Copy this file to .env and fill in values

# Server port
PORT=3000

# JWT secret for token signing (change in production!)
JWT_SECRET=you...t

# Database path (SQLite)
DATABASE_URL=data/workout-tracker.sqlite

# Neon PostgreSQL (for production deployment)
# NEON_DATABASE_URL=postgresql://user:***@ep-xxx.us-east-2.aws.neon.tech/workout-tracker?sslmode=require
